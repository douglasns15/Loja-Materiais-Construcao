# =============================================================================
# NexoLoja — PWA (apps/web). Copie para `.env.local`.
# =============================================================================
# O Next.js lê variáveis da PASTA DO APP — o `.env` da raiz NÃO é usado aqui.
# O prefixo `NEXT_PUBLIC_` é obrigatório para expor a variável ao navegador.
# `.env.local` já está no .gitignore.
# =============================================================================

# Mesmos valores de SUPABASE_URL / SUPABASE_ANON_KEY do `.env` da raiz.
# São publicáveis: o isolamento entre lojas é garantido por RLS no banco.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# API Hono. Local (`npm run dev:api`) usa a porta 8787.
# Para apontar à API publicada: https://nexoloja-api.imortal.workers.dev
NEXT_PUBLIC_API_URL="http://localhost:8787"
