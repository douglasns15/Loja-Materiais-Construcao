# =============================================================================
# NexoLoja — variáveis da RAIZ (Prisma + scripts de packages/db)
# =============================================================================
# Copie para `.env` e preencha. NUNCA commite o `.env` (já está no .gitignore).
# Os valores vêm do painel do Supabase: Project Settings → Database / API.
#
# Estas variáveis atendem o Prisma (migrations, `prisma studio`) e os scripts
# em `packages/db/scripts/`. O app web e a API têm arquivos PRÓPRIOS — veja
# `apps/web/.env.local.example` e `apps/api/.env.example`.
# =============================================================================

# --- Banco (Supabase Postgres) ----------------------------------------------
# Use o "Session pooler" (porta 5432): é o endpoint IPv4 e suporta prepared
# statements, que o Prisma utiliza. O host direto (db.<ref>.supabase.co) é
# IPv6-only no free tier. Ver docs/plano-producao.md.
DATABASE_URL="postgresql://postgres.<ref>:<SENHA>@aws-1-<região>.pooler.supabase.com:5432/postgres"

# Usada pelas migrations (`prisma migrate`). Mesma string do pooler em sessão.
DIRECT_URL="postgresql://postgres.<ref>:<SENHA>@aws-1-<região>.pooler.supabase.com:5432/postgres"

# --- Supabase (API) ----------------------------------------------------------
# Project Settings → API
SUPABASE_URL="https://<ref>.supabase.co"

# Chave pública ("anon"/publishable). Segura no cliente: é protegida por RLS.
SUPABASE_ANON_KEY="<anon-key>"

# ⚠️ SEGREDO — ignora o RLS. Usada só por scripts administrativos
# (create-user.mjs, bootstrap-tenant.mjs) e pelo Worker via `wrangler secret`.
# NUNCA exponha ao navegador nem commite.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
