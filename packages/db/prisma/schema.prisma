// =============================================================================
// NexoLoja - Schema do Banco de Dados (Supabase / PostgreSQL)
// =============================================================================
// Arquitetura: Multi-Tenant, Modular e Offline-First
//
// Princípios seguidos (conforme CLAUDE.md):
//  - Multi-tenancy estrito: toda tabela de dados possui `tenantId` (UUID da loja)
//  - Tipos leves: SmallInt para status/enums, VarChar com limite estrito
//  - Proibido salvar BLOBs: apenas URLs de mídia (Cloudflare R2)
//  - Campos de sincronização offline: `id` UUID gerado no cliente, `syncStatus`
//  - Módulos ativáveis: tabela `TenantModule` controla quais módulos cada loja usa
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Pooler 6543 (pgbouncer) — runtime da aplicação
  directUrl = env("DIRECT_URL") // Porta direta 5432 — usada pelas migrations (migrate/diff)
}

// =============================================================================
// ENUMS
// =============================================================================

/// Status de sincronização para suporte Offline-First (IndexedDB → Supabase)
enum SyncStatus {
  PENDING // Criado localmente, aguardando envio ao servidor
  SYNCED // Confirmado no servidor
  CONFLICT // Conflito detectado durante sincronização
}

/// Tipo de movimentação financeira
enum TransactionType {
  INCOME // Entrada
  EXPENSE // Saída
}

/// Status de um pedido/venda
enum OrderStatus {
  DRAFT // Rascunho (aberto no caixa offline)
  CONFIRMED // Confirmado
  INVOICED // Faturado / NF emitida
  CANCELLED // Cancelado (estorno dentro do caixa aberto)
  RETURNED // Devolvido (estorno de venda de caixa já fechado — saída no caixa de hoje)
}

/// Natureza de uma movimentação de caixa que não é uma venda (CashMovement).
enum CashMovementKind {
  RETURN // Devolução de venda (saída de dinheiro)
  WITHDRAWAL // Sangria — retirada de dinheiro do caixa (saída)
  SUPPLY // Suprimento — reforço de troco (entrada)
  EXPENSE // Despesa paga pelo caixa (saída)
}

/// Situação de uma conta a receber (venda a prazo / "fiado" — ADR-019).
enum ReceivableStatus {
  OPEN // Em aberto (ainda há saldo devedor)
  PAID // Quitada (recebida por inteiro)
  CANCELLED // Cancelada (a venda de origem foi cancelada/devolvida antes de qualquer recebimento)
}

/// Estado da DÍVIDA do cliente (ADR-026 — conta-corrente com código D-0001). OPEN enquanto há saldo
/// devedor somando as vendas a prazo que a compõem; PAID quando o saldo zera (por recebimento e/ou
/// devolução). Sem CANCELLED próprio: uma dívida vazia (todas as vendas canceladas) simplesmente
/// fica sem recebíveis ativos — o estado é derivado do saldo.
enum DebtStatus {
  OPEN // Em aberto (há saldo devedor)
  PAID // Quitada (saldo zerado) — arquivada na aba "Quitadas"
}

/// Destino do EXCEDENTE de uma devolução (ADR-022) — o que sobra depois de abater a dívida da
/// venda: vira crédito na loja (abatido numa próxima compra) OU devolução em dinheiro pelo caixa.
/// Escolha do operador no momento da devolução.
enum ReturnTarget {
  STORE_CREDIT // Crédito a favor do cliente (Customer.creditBalance + livro-razão customer_credits)
  CASH // Devolução em dinheiro no caixa de hoje (CashMovement RETURN — exige caixa aberto)
}

/// Ciclo de vida do ORÇAMENTO (ADR-024). "Expirado" NÃO entra aqui: é DERIVADO de `validUntil` na
/// exibição/busca (evita depender de um agendador — custo-zero). Enviado/Aceito/Recusado são marcados
/// manualmente pelo operador enquanto não houver envio por WhatsApp/e-mail.
enum QuoteStatus {
  DRAFT // Rascunho (editável, reabrindo no PDV)
  SENT // Enviado ao cliente (a partir daqui o conteúdo trava — para mudar, duplica)
  ACCEPTED // Aceito pelo cliente
  REJECTED // Recusado (terminal)
  CONVERTED // Convertido em venda (terminal; ver `convertedOrderId`)
}

/// Tipo de unidade de medida — relevante para módulo Material de Construção
enum UnitType {
  UNIT // Unidade (un)
  METER // Metro linear (m)
  SQUARE_METER // Metro quadrado (m²)
  CUBIC_METER // Metro cúbico (m³)
  KILOGRAM // Quilograma (kg)
  LITER // Litro (l)
  THOUSAND // Milheiro (mil) — ex: tijolos
  BAG // Saco (sc) — ex: cimento
  ROLL // Rolo — ex: manta, tela
  BARRA // Barra — ex: vergalhão/perfil vendido em barra fechada, cortável por metro (ADR-017)
}

/// Papel do usuário dentro de um tenant
enum UserRole {
  OWNER // Dono da loja (acesso total)
  MANAGER // Gerente
  CASHIER // Operador de caixa
  STOCK // Responsável de estoque
}

/// Status de entrega (ADR-002)
enum DeliveryStatus {
  PENDING // Pendente
  IN_ROUTE // Em rota
  DELIVERED // Entregue
  CANCELLED // Cancelado
}

/// Modo de saída da mercadoria de um pedido (ADR-020 — retirada/entrega futura).
enum DeliveryMode {
  IMMEDIATE // Venda de balcão: a mercadoria sai no ato (baixa de estoque na venda — comportamento padrão)
  SCHEDULED // Retirada/entrega posterior: reserva na venda, baixa real só na retirada (parcial, conforme sai)
}

/// Situação de retirada de um pedido SCHEDULED (ADR-020). Cache derivado dos itens,
/// no espírito do ADR-001 (cache desnormalizado + itens/eventos como fonte de verdade).
enum FulfillmentStatus {
  PENDING // Nada saiu ainda
  PARTIAL // Parte dos itens já foi retirada
  COMPLETED // Tudo retirado — pedido finalizado
}

// =============================================================================
// MÓDULO CORE — Tenants (Lojas) e Usuários
// =============================================================================

/// Representa uma loja/empresa (tenant). Raiz do multi-tenancy.
model Tenant {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @db.VarChar(120)
  slug                 String   @unique @db.VarChar(60) // Identificador único amigável (ex: "loja-do-ze")
  cnpj                 String?  @unique @db.VarChar(18)
  phone                String?  @db.VarChar(20)
  logoUrl              String?  @db.VarChar(500) // URL no Cloudflare R2 — nunca BLOB
  /// Taxa da maquininha por modalidade, em PERCENTUAL (ADR-016). Ex.: 3.50 = 3,5%.
  /// Serve APENAS para exibir a margem REAL (o que sobra depois da taxa) — nunca altera o preço
  /// cobrado do cliente. Quem altera preço é o acréscimo opt-in de cada produto. Vazio ⇒ margem
  /// exibida como sempre foi (sem desconto de taxa).
  cardFeeDebitPercent  Decimal? @db.Decimal(5, 2)
  cardFeeCreditPercent Decimal? @db.Decimal(5, 2)
  /// Fechamento CEGO (blind close): quando `true`, a tela do Caixa esconde o Esperado e a quebra
  /// de valores ao fechar; o operador conta a gaveta às cegas e só então "revela" a divergência.
  /// Prática anti-viés (evita ajustar a contagem para bater com o esperado). `false` = fechamento
  /// normal, com a conferência à vista. Ajuste por loja, definido pelo dono nas Configurações.
  blindCashClose       Boolean  @default(false)
  // Contador de vendas da loja (ADR-023): o ÚLTIMO número emitido. A venda aloca o próximo com um
  // incremento atômico (UPDATE ... RETURNING) dentro da transação — à prova de corrida, sem furo em
  // rollback. Backfill na migration 0021 acertou cada loja para o maior nº já emitido (0 se sem vendas).
  lastOrderNumber      Int      @default(0)
  // Contador de ORÇAMENTOS da loja (ADR-024): último nº emitido, exibido como "O-000045". Mesma
  // mecânica atômica do `lastOrderNumber`; sequência SEPARADA (o prefixo O-/V- distingue). 0 = sem
  // orçamentos ainda (migration 0022 nasce assim para todas as lojas — sem backfill, tabelas vazias).
  lastQuoteNumber      Int      @default(0)
  // Contador de DÍVIDAS da loja (ADR-026): último nº emitido, exibido como "D-0001". Mesma mecânica
  // atômica do `lastOrderNumber`; sequência SEPARADA (prefixo D-). Alocado ao ABRIR uma dívida (1ª
  // venda a prazo de um cliente sem dívida aberta). Backfill na migration 0030 acerta cada loja.
  lastDebtNumber       Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relações
  users               User[]
  modules             TenantModule[]
  products            Product[]
  categories          Category[]
  customers           Customer[]
  suppliers           Supplier[]
  orders              Order[]
  payments            Payment[]
  cashSessions        CashSession[]
  cashMovements       CashMovement[]
  stockMovements      StockMovement[]
  deliveries          Delivery[]
  auditEvents         AuditEvent[]
  receivables         Receivable[]
  receivablePayments  ReceivablePayment[]
  debts               Debt[]
  orderItemDeliveries OrderItemDelivery[]
  carts               Cart[]
  orderReturns        OrderReturn[]
  orderReturnItems    OrderReturnItem[]
  customerCredits     CustomerCredit[]
  quotes              Quote[]
  quoteItems          QuoteItem[]
  nfeImportItems      NfeImportItem[]

  @@map("tenants")
}

/// Módulos ativáveis por tenant (ex: "CONSTRUCTION_MATERIALS", "FOOD", "CLOTHING")
model TenantModule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  moduleKey String   @db.VarChar(60) // Ex: "CONSTRUCTION_MATERIALS"
  isActive  Boolean  @default(true)
  config    Json? // Configurações específicas do módulo (JSON leve)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@map("tenant_modules")
}

/// Usuário do sistema. Pertence a um único tenant.
/// ADR-005: as credenciais são propriedade do Supabase Auth (auth.users), não desta tabela.
/// `id` é fornecido pela aplicação e DEVE ser igual ao `auth.users.id` do Supabase Auth.
/// O vínculo formal (FK cross-schema para auth.users) será configurado na Fase 2 (Auth/RLS).
model User {
  id        String   @id @db.Uuid // = Supabase Auth user id (auth.users.id)
  tenantId  String   @db.Uuid
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(150)
  phone     String?  @db.VarChar(20) // Telefone pessoal do usuário (opcional; só dígitos)
  role      UserRole @default(CASHIER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders       Order[]
  cashSessions CashSession[]
  cart         Cart? // Cesta persistente do PDV (ADR-021): uma por usuário

  @@unique([tenantId, email])
  @@map("users")
}

/// Super Usuário (fabricante) — identidade de PLATAFORMA, acima de qualquer loja (ADR-009).
/// NÃO pertence a um tenant (sem `tenantId`/FK): é cross-tenant. `id` = `auth.users.id`
/// (Supabase Auth), como em `User`. O acesso a várias lojas é feito por rotas `/platform/*`
/// dedicadas (API dona do banco), nunca relaxando o RLS. RLS ligado sem política de cliente
/// (só a API-dono lê); o access token hook (supabase_auth_admin) lê esta tabela para injetar
/// o claim `is_platform_admin` no JWT — atalho de UI; a autorização confia na tabela.
model PlatformAdmin {
  id        String   @id @db.Uuid // = Supabase Auth user id (auth.users.id)
  email     String   @unique @db.VarChar(150)
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_admins")
}

// =============================================================================
// MÓDULO CORE — Catálogo de Produtos
// =============================================================================

/// Categoria de produto. Hierarquia simples (pai/filho).
model Category {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  parentId  String?   @db.Uuid // Subcategoria (opcional)
  name      String    @db.VarChar(80)
  isActive  Boolean   @default(true)
  deletedAt DateTime? // Soft-delete (ADR-004)
  createdAt DateTime  @default(now())

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([tenantId, name, parentId])
  @@map("categories")
}

/// Produto do catálogo. Suporta unidades especiais do módulo Material de Construção.
model Product {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @db.Uuid
  categoryId       String?    @db.Uuid
  sku              String     @db.VarChar(60) // Código interno ou código de barras
  /// Código de barras GTIN-8/12/13/14 (EAN/UPC), opcional. DISTINTO do `sku` (código interno da
  /// loja): um produto pode ter SKU interno E código de barras oficial. É a chave de enriquecimento
  /// pelo catálogo global (ADR-025) e alimenta a busca por leitura de scanner junto com o `sku`.
  /// Não-único de propósito (não quebra legado nem importação de NF-e); unicidade fica na aplicação.
  ean              String?    @db.VarChar(14)
  name             String     @db.VarChar(150)
  /// Nome popular/regional do produto — usado para busca no PDV além do nome oficial.
  /// Genérico p/ qualquer ramo. Ex.: "Ferro 8" p/ "Vergalhão CA-50 8mm"; "Dipirona" p/ "Dipirona Sódica 500mg".
  popularName      String?    @db.VarChar(150)
  /// Fabricante/marca do produto (ex.: "Votorantim", "Tigre"). Genérico p/ qualquer ramo.
  /// Também entra na busca (nome, nome popular, SKU e fabricante) — daí o índice abaixo.
  manufacturer     String?    @db.VarChar(120)
  description      String?    @db.VarChar(500)
  imageUrl         String?    @db.VarChar(500) // URL no Cloudflare R2 — nunca BLOB
  unit             UnitType   @default(UNIT)
  /// Fator de conversão para módulo Material de Construção (ADR-013 — EF-3).
  /// Ex: 1 milheiro = 1000 unidades → conversionFactor = 1000; 1 rolo = 100 metros → 100.
  /// Reusado como TAMANHO da embalagem alternativa (unidade-base por embalagem fechada).
  conversionFactor Decimal?   @db.Decimal(10, 4)
  costPrice        Decimal    @db.Decimal(12, 4)
  salePrice        Decimal    @db.Decimal(12, 4)
  /// Aviso de revisão de preço (item 5 da esteira de precificação): quando uma Entrada de estoque
  /// sobrescreve o `costPrice` ("último custo", ADR de 2026-08-11), a margem muda em todo o sistema
  /// mas o `salePrice` NÃO — então marcamos aqui o instante do ajuste. O cadastro do produto mostra
  /// um aviso discreto "custo ajustado, confira o preço" até o operador reconhecer (limpa no PATCH
  /// com `dismissPriceReview`). NULL ⇒ nada pendente. Só sinaliza; nunca altera preço automaticamente.
  priceReviewPendingAt DateTime?
  /// Venda em unidade alternativa (ADR-013 — EF-3). Quando `altUnit` + `altSalePrice` +
  /// `conversionFactor` estão preenchidos, o produto pode ser vendido também na embalagem
  /// fechada (ex.: ROLO de 100 m) com PREÇO PRÓPRIO — o fechado costuma sair mais barato por
  /// unidade-base, então NÃO é `salePrice × conversionFactor`. Vazio ⇒ produto de uma unidade só.
  altUnit          UnitType? // Unidade da embalagem fechada (ex.: ROLL)
  altSalePrice     Decimal?   @db.Decimal(12, 4) // Preço de 1 embalagem fechada
  /// Produto agregado (ADR-015): o par "parafuso + bucha". Os dois seguem sendo produtos
  /// independentes (preço e estoque próprios); juntos, saem por `pairPrice` — o preço TOTAL
  /// do par, NÃO por item. Grava-se só de UM lado; o outro é resolvido por consulta reversa
  /// (`pairedBy`), então é impossível os dois lados divergirem de preço. Vazio ⇒ sem par.
  pairedProductId  String?    @db.Uuid
  pairPrice        Decimal?   @db.Decimal(12, 4)
  /// Acréscimo por forma de pagamento (ADR-016). Valor em R$ POR UNIDADE-BASE que é somado ao
  /// preço quando a venda é no débito/crédito — é quanto o preço SOBE, não um custo nem o preço
  /// final. Opt-in por produto: vazio ⇒ o produto não muda de preço naquela forma de pagamento
  /// (nunca é derivado automaticamente da taxa da maquininha do tenant, que é só informativa).
  /// Na embalagem fechada (EF-3) é aplicado proporcionalmente (× `conversionFactor`); no par
  /// (ADR-015), os acréscimos dos dois lados se somam ANTES do rateio. CASH/PIX nunca acrescem.
  surchargeDebit   Decimal?   @db.Decimal(12, 4)
  surchargeCredit  Decimal?   @db.Decimal(12, 4)
  stockQty         Decimal    @default(0) @db.Decimal(12, 4)
  /// Cache desnormalizado do total RESERVADO em unidade-base (ADR-020), análogo ao `stockQty`
  /// (ADR-001). Soma do que está comprometido com pedidos SCHEDULED ainda não retirados. O PDV
  /// trava pelo DISPONÍVEL = `stockQty − reservedQty` (não vende a mesma peça 2×). Fonte de
  /// verdade = Σ dos itens reservados; existe reconciliação no mesmo espírito do `stockQty`.
  reservedQty      Decimal    @default(0) @db.Decimal(12, 4)
  minStockQty      Decimal    @default(0) @db.Decimal(12, 4)
  isActive         Boolean    @default(true)
  deletedAt        DateTime? // Soft-delete (ADR-004)
  /// Peso em kg — usado para cálculo de frete pesado (módulo Material de Construção)
  weightKg         Decimal?   @db.Decimal(8, 3)
  // Campos de sincronização offline
  syncStatus       SyncStatus @default(SYNCED)
  updatedAt        DateTime   @updatedAt
  createdAt        DateTime   @default(now())
  // Autoria (ADR-010): quem criou/alterou/excluiu. `*Id` é referência SOLTA (sem FK, sobrevive à
  // exclusão do usuário); `*Name` é snapshot congelado do nome no momento (exibido em tela).
  createdById      String?    @db.Uuid
  createdByName    String?    @db.VarChar(100)
  updatedById      String?    @db.Uuid
  updatedByName    String?    @db.VarChar(100)
  deletedById      String?    @db.Uuid
  deletedByName    String?    @db.VarChar(100)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  quoteItems     QuoteItem[]
  stockMovements StockMovement[]
  nfeImportItems NfeImportItem[]
  // Auto-relação do par (ADR-015). `SetNull`: se o agregado for apagado de vez, o par
  // simplesmente deixa de existir e o produto principal segue vendendo avulso.
  pairedProduct  Product?        @relation("ProductPair", fields: [pairedProductId], references: [id], onDelete: SetNull)
  pairedBy       Product[]       @relation("ProductPair")

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@index([tenantId, popularName])
  @@index([tenantId, manufacturer])
  @@index([tenantId, pairedProductId])
  // Busca por código de barras (scanner) e casamento na importação de NF-e (ADR-025).
  @@index([tenantId, ean])
  @@map("products")
}

/// Catálogo global de ficha técnica por EAN — cache de enriquecimento COMPARTILHADO entre TODAS as
/// lojas (ADR-025). Diferente de todo o resto do schema, é CROSS-TENANT: NÃO tem `tenantId`, uma
/// linha por GTIN. Guarda só dado de ficha técnica PÚBLICO (nome oficial, marca, NCM, foto) — nunca
/// preço, custo ou estoque, que continuam no `Product` de cada loja (fonte de verdade). O que uma
/// loja busca/importa (leitura de EAN externa ou XML de NF-e) alimenta o cache e a próxima loja já
/// acha de graça, sem nova chamada externa.
///
/// SEGURANÇA (exceção consciente ao RLS-por-tenant): a migration habilita RLS SEM policy nenhuma, o
/// que BLOQUEIA qualquer acesso via `supabase-js`/PostgREST (anon/authenticated). Todo acesso passa
/// pela API (papel `postgres`/Prisma pela conexão pooled, que ignora RLS). Como não há dado
/// comercial aqui, o pior caso de vazamento seria ficha técnica pública de produto.
///
/// CUSTO-ZERO: `imageUrl` guarda a URL EXTERNA pública (hotlink do CDN da fonte, ex.: Open Food
/// Facts) — nunca baixamos o binário para o R2 nem BLOB no banco (CLAUDE.md §6 / ADR-007).
model ProductCatalog {
  /// GTIN-8/12/13/14 normalizado (só dígitos). Chave natural — uma ficha por código de barras.
  ean          String   @id @db.VarChar(14)
  /// Nome oficial do produto conforme a fonte (xProd da NF-e ou nome da API). Pode divergir do
  /// `nome_exibicao` que a loja usa no PDV — este é só a referência de ficha técnica.
  officialName String?  @db.VarChar(200)
  /// Marca/fabricante conforme a fonte.
  brand        String?  @db.VarChar(120)
  /// NCM (Nomenclatura Comum do Mercosul), 8 dígitos — útil para fiscal/relatórios futuros.
  ncm          String?  @db.VarChar(8)
  /// URL EXTERNA pública da foto (hotlink). Nunca binário no banco nem cópia no R2 (custo-zero).
  imageUrl     String?  @db.VarChar(500)
  /// Origem do dado: 'off' (Open Food Facts) | 'cosmos' (Bluesoft) | 'nfe' (XML de nota) |
  /// 'manual' (digitado pelo lojista). Ajuda a priorizar/depurar a procedência do enriquecimento.
  source       String?  @db.VarChar(30)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("product_catalog_global")
}

// =============================================================================
// MÓDULO CORE — Clientes e Fornecedores
// =============================================================================

/// Cliente da loja.
model Customer {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid
  name          String     @db.VarChar(120)
  cpfCnpj       String?    @db.VarChar(18)
  phone         String?    @db.VarChar(20)
  email         String?    @db.VarChar(150)
  address       String?    @db.VarChar(300)
  notes         String?    @db.VarChar(500) // Observação do CADASTRO (perfil do cliente)
  // Observação da DÍVIDA/conta (ADR-022) — uma nota por cliente, compartilhada por todas as vendas
  // a prazo dele, EDITADA nas telas de Contas a Receber. Separada de `notes` (cadastro): nunca se
  // cruzam. Aditiva/nullable (migration 0018).
  debtNotes     String?    @db.VarChar(500)
  /// Saldo de CRÉDITO a favor do cliente (ADR-022) — cache desnormalizado, análogo ao
  /// `Product.stockQty` (ADR-001). A fonte de verdade é o livro-razão `customer_credits` (Σ amount).
  /// Nasce de devoluções que o operador manda para crédito; é consumido numa próxima venda (Fatia C).
  creditBalance Decimal    @default(0) @db.Decimal(12, 2)
  isActive      Boolean    @default(true)
  deletedAt     DateTime? // Soft-delete (ADR-004)
  // Campos de sincronização offline
  syncStatus    SyncStatus @default(SYNCED)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  // Autoria (ADR-010): quem criou/alterou/excluiu. `*Id` referência solta (sem FK); `*Name` snapshot.
  createdById   String?    @db.Uuid
  createdByName String?    @db.VarChar(100)
  updatedById   String?    @db.Uuid
  updatedByName String?    @db.VarChar(100)
  deletedById   String?    @db.Uuid
  deletedByName String?    @db.VarChar(100)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders      Order[]
  deliveries  Delivery[]
  receivables Receivable[]
  debts       Debt[]
  returns     OrderReturn[]
  credits     CustomerCredit[]
  quotes      Quote[]

  @@unique([tenantId, cpfCnpj])
  @@index([tenantId, name])
  @@map("customers")
}

/// Fornecedor de produtos.
model Supplier {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String    @db.VarChar(120)
  cnpj      String?   @db.VarChar(18)
  phone     String?   @db.VarChar(20)
  email     String?   @db.VarChar(150)
  address   String?   @db.VarChar(300)
  notes     String?   @db.VarChar(500) // Observação livre do cadastro do fornecedor (migration 0027)
  isActive  Boolean   @default(true)
  deletedAt DateTime? // Soft-delete (ADR-004)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@unique([tenantId, cnpj])
  @@map("suppliers")
}

// =============================================================================
// MÓDULO CORE — Vendas (PDV / Caixa)
// =============================================================================

/// Sessão de caixa. Controla abertura/fechamento e totais do operador.
model CashSession {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @db.Uuid
  userId         String     @db.Uuid
  openedAt       DateTime   @default(now())
  closedAt       DateTime?
  openingAmount  Decimal    @db.Decimal(12, 2) // Valor de abertura do caixa
  closingAmount  Decimal?   @db.Decimal(12, 2) // Valor de fechamento informado
  expectedAmount Decimal?   @db.Decimal(12, 2) // Valor calculado pelo sistema
  notes          String?    @db.VarChar(500)
  // Campos de sincronização offline
  syncStatus     SyncStatus @default(SYNCED)
  // Autoria (ADR-010): `userId` (com FK) é quem abriu; snapshot do nome + quem fechou (solto).
  openedByName   String?    @db.VarChar(100)
  closedById     String?    @db.Uuid
  closedByName   String?    @db.VarChar(100)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])
  orders    Order[]
  movements CashMovement[]

  @@index([tenantId, openedAt])
  @@map("cash_sessions")
}

/// Pedido / Venda. Criado no caixa (pode ser offline).
model Order {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  // Código sequencial POR LOJA (ADR-023), atribuído no servidor. Exibido como "V-000128"
  // (`formatOrderNumber`). Único por loja (`@@unique` abaixo); é a identidade humana/de busca da
  // venda — o `id` UUID segue sendo a PK. Backfill na migration 0021 numerou os pedidos existentes.
  orderNumber       Int
  cashSessionId     String?            @db.Uuid
  userId            String             @db.Uuid // Operador que realizou a venda
  customerId        String?            @db.Uuid
  status            OrderStatus        @default(DRAFT)
  subtotal          Decimal            @db.Decimal(12, 2)
  discountAmount    Decimal            @default(0) @db.Decimal(12, 2)
  freightAmount     Decimal            @default(0) @db.Decimal(12, 2) // Frete pesado (módulo Material de Construção)
  total             Decimal            @db.Decimal(12, 2)
  // Troco devolvido ao cliente (informativo — NÃO entra no caixa; a invariante do ADR-016 é que as
  // parcelas somam exatamente o total e o dinheiro do caixa é líquido). NULL = venda antiga sem o dado
  // registrado (migration 0024, aditiva); vendas novas gravam 0 quando não há troco. Usado para exibir
  // "Dinheiro recebido" e "Troco" no Histórico e na reimpressão.
  changeAmount      Decimal?           @db.Decimal(12, 2)
  notes             String?            @db.VarChar(500)
  // Retirada/entrega futura (ADR-020). Em pedidos IMMEDIATE (padrão) estes campos ficam
  // inertes e o comportamento é o de sempre (baixa no ato).
  deliveryMode      DeliveryMode       @default(IMMEDIATE) // SCHEDULED = reserva agora, sai depois
  fulfillmentStatus FulfillmentStatus? // Só p/ SCHEDULED; null em IMMEDIATE. Cache derivado dos itens.
  scheduledPickupAt DateTime? // Previsão ÚNICA de retirada (modo padrão)
  perItemSchedule   Boolean            @default(false) // Flag "Data por item": true ⇒ a previsão vem de cada OrderItem
  // Campos de sincronização offline
  syncStatus        SyncStatus         @default(PENDING) // Vendas nascem como PENDING no caixa offline
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  // Autoria (ADR-010): `userId` (com FK) é o operador; `registeredByName` é o snapshot do nome.
  registeredByName  String?            @db.VarChar(100)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSession    CashSession?        @relation(fields: [cashSessionId], references: [id])
  user           User                @relation(fields: [userId], references: [id])
  customer       Customer?           @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  delivery       Delivery?
  receivable     Receivable?
  itemDeliveries OrderItemDelivery[]
  returns        OrderReturn[]
  // ADR-024: orçamento(s) que apontam para esta venda como conversão (elo em quotes.convertedOrderId).
  // Modelado como lista (1:N) só para satisfazer o Prisma sem exigir índice único no FK — na prática é
  // 0..1 (uma venda nasce de no máximo um orçamento). Acesso natural é pelo lado do Quote.
  convertedFromQuotes Quote[]

  @@unique([tenantId, orderNumber]) // Código sequencial por loja (ADR-023); também indexa a busca por nº
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, fulfillmentStatus])
  @@map("orders")
}

/// Item de um pedido.
model OrderItem {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @db.Uuid
  productId         String    @db.Uuid
  productName       String    @db.VarChar(150) // Snapshot do nome no momento da venda
  unit              UnitType // Snapshot da unidade vendida (base OU embalagem — ADR-013)
  quantity          Decimal   @db.Decimal(12, 4) // Quantidade na unidade VENDIDA (ex.: 2 rolos)
  /// Quantidade em UNIDADE-BASE debitada do estoque (ADR-013 — EF-3). Snapshot congelado no
  /// momento da venda: modo embalagem ⇒ quantity × conversionFactor (ex.: 2 rolos = 200 m);
  /// modo base ⇒ igual a `quantity`. NULL em pedidos antigos (pré-EF-3) — o estorno usa
  /// `baseQuantity ?? quantity`, que é exato para eles (fator 1). Base do estorno de estoque
  /// no cancelamento/devolução (ADR-001), robusto mesmo se `conversionFactor` mudar depois.
  baseQuantity      Decimal?  @db.Decimal(12, 4)
  unitPrice         Decimal   @db.Decimal(12, 4) // Preço na unidade vendida (ex.: preço do rolo)
  /// Custo unitário CONGELADO no momento da venda (ADR-027) — snapshot do `Product.costPrice`
  /// vigente na criação do pedido. Igual ao padrão de snapshot do item (ADR-001): não depende de
  /// valor mutável do produto, então reajustar o custo do cadastro depois NÃO distorce a margem
  /// histórica. NULL em vendas anteriores a esta migration ("custo desconhecido"): a venda entra no
  /// faturamento, mas fica FORA do lucro — nunca contada como custo zero (que inflaria o lucro).
  /// Por UNIDADE-BASE (mesma base de `costPrice`, do estoque e de `baseQuantity`) — NÃO da unidade
  /// vendida. O custo da linha (Fatia 6) é `unitCost × (baseQuantity ?? quantity)`, casando com o
  /// débito de estoque (ADR-013); assim funciona também no modo embalagem (ex.: 2 rolos = 200 m).
  unitCost          Decimal?  @db.Decimal(12, 4)
  discount          Decimal   @default(0) @db.Decimal(12, 4)
  total             Decimal   @db.Decimal(12, 2)
  /// Agrupamento do par (ADR-015). Itens do MESMO pedido com o mesmo `pairGroup` foram vendidos
  /// juntos como par e imprimem como UMA linha no comprovante ("Parafuso + Bucha nº10"). Numerado
  /// por pedido (1, 2, 3…) — a mesma venda pode ter vários pares. NULL = item avulso, que é o caso
  /// de todos os pedidos anteriores a esta migration.
  pairGroup         Int?      @db.SmallInt
  /// Retirada/entrega futura (ADR-020). Quanto (em UNIDADE-BASE) desta linha JÁ SAIU do estoque —
  /// cache do total retirado, análogo ao `Receivable.settledAmount` (ADR-019). Reservado da linha =
  /// `(baseQuantity ?? quantity) − deliveredBaseQty` enquanto o pedido é SCHEDULED e não CANCELLED;
  /// linha finalizada quando iguala `baseQuantity`. 0 em vendas IMMEDIATE (saída no ato).
  deliveredBaseQty  Decimal   @default(0) @db.Decimal(12, 4)
  /// Previsão de retirada POR ITEM (ADR-020). Usada quando `Order.perItemSchedule = true`; caso
  /// contrário vale a previsão única do pedido (`Order.scheduledPickupAt`). Opcional.
  scheduledPickupAt DateTime?
  /// Quanto (em UNIDADE-BASE) desta linha JÁ FOI DEVOLVIDO (ADR-022) — cache do total devolvido,
  /// análogo ao `deliveredBaseQty` (ADR-020). Devolvível = `(baseQuantity ?? quantity) −
  /// returnedBaseQty`; trava contra devolver a mesma peça duas vezes. 0 em itens nunca devolvidos.
  returnedBaseQty   Decimal   @default(0) @db.Decimal(12, 4)

  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product             @relation(fields: [productId], references: [id])
  deliveries OrderItemDelivery[]
  returns    OrderReturnItem[]

  @@map("order_items")
}

/// Pagamento de um pedido. Um pedido pode ter múltiplos pagamentos (ex: dinheiro + cartão).
/// ADR-003: tenantId denormalizado para multi-tenancy estrito e RLS
model Payment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid // Denormalizado para isolamento multi-tenant (ADR-003)
  orderId   String   @db.Uuid
  method    String   @db.VarChar(30) // Ex: "CASH", "CREDIT_CARD", "PIX", "BOLETO"
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @default(now())
  reference String?  @db.VarChar(100) // NSU, código de transação, etc.

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("payments")
}

/// Conta a receber de uma venda a prazo ("fiado" — ADR-019). Uma venda gera NO MÁXIMO uma
/// conta (`orderId` único): o valor a prazo da venda. O saldo devedor = `originalAmount −
/// settledAmount` (derivado). A mercadoria já saiu na venda (o fiado adia o pagamento, não a
/// entrega — o motor de estoque NÃO muda); só o dinheiro fica pendente aqui.
model Receivable {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid // Denormalizado para isolamento multi-tenant (ADR-003)
  orderId        String           @unique @db.Uuid // A venda que originou a dívida (1 conta por venda)
  customerId     String           @db.Uuid // O devedor (obrigatório — não há fiado anônimo)
  // Dívida do cliente (ADR-026) que AGREGA esta venda a prazo — a conta-corrente "D-0001". Nullable só
  // por causa do backfill (migration 0030): vendas novas SEMPRE preenchem (a venda resolve/cria a
  // dívida aberta do cliente sob a transação). O saldo da dívida = Σ dos saldos devedores dos seus
  // recebíveis; a dívida é a unidade de quitação (recebe-se a dívida, não a venda nem o item).
  debtId         String?          @db.Uuid
  originalAmount Decimal          @db.Decimal(12, 2) // Valor a prazo original da venda
  settledAmount  Decimal          @default(0) @db.Decimal(12, 2) // Quanto já foi recebido (corrente)
  /// Quanto da dívida foi abatido por DEVOLUÇÃO de itens (ADR-022) — distinto de `settledAmount`
  /// (dinheiro recebido). Saldo devedor = `originalAmount − settledAmount − returnedAmount`; vira
  /// PAID (sem saldo) quando recebido + devolvido alcança o original.
  returnedAmount Decimal          @default(0) @db.Decimal(12, 2)
  status         ReceivableStatus @default(OPEN)
  dueDate        DateTime? // Vencimento opcional (destaca vencidos)
  notes          String?          @db.VarChar(500) // Observação livre da dívida (ex.: "prometeu pagar dia 10")
  createdAt      DateTime         @default(now())
  // Autoria (ADR-010): quem registrou a venda a prazo. Referência solta (sem FK); snapshot do nome.
  createdById    String?          @db.Uuid
  createdByName  String?          @db.VarChar(100)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer            @relation(fields: [customerId], references: [id])
  debt     Debt?               @relation(fields: [debtId], references: [id], onDelete: SetNull)
  payments ReceivablePayment[]

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, dueDate])
  @@index([debtId])
  @@map("receivables")
}

/// Dívida do cliente (ADR-026) — a conta-corrente do fiado, com identidade "D-0001". Agrega 1+ vendas
/// a prazo (`receivables`) do mesmo cliente e é a UNIDADE DE QUITAÇÃO: recebe-se o saldo da dívida
/// (distribuído FIFO entre os recebíveis), não a venda nem o item. Regra de aplicação: no máximo UMA
/// `OPEN` por (tenant, customer) — a venda a prazo resolve/abre a dívida aberta sob a transação. O
/// saldo/estado é DERIVADO dos recebíveis (Σ saldos devedores); `status`/`closedAt` são cache do ciclo.
model Debt {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid // Denormalizado para RLS (ADR-003)
  customerId    String     @db.Uuid // O devedor
  // Código sequencial POR LOJA (ADR-023/ADR-026), exibido "D-0001" (`formatDebtNumber`). Único por
  // loja; alocado atômico (`Tenant.lastDebtNumber` UPDATE ... RETURNING) ao ABRIR a dívida.
  debtNumber    Int
  status        DebtStatus @default(OPEN)
  // Vencimento da DÍVIDA (ADR-026, Opção A): UM vencimento por dívida, ATUALIZADO a cada venda a
  // prazo que informa uma data (a última digitada vence). Omitir a data numa venda seguinte NÃO
  // limpa o que já havia. Data-only (meia-noite UTC do dia) — a UI formata em UTC (`formatDateBr`).
  dueDate       DateTime?
  openedAt      DateTime   @default(now())
  closedAt      DateTime? // Quando o saldo zerou (dívida quitada/arquivada)
  // Autoria (ADR-010): quem abriu (1ª venda a prazo). Referência solta; snapshot do nome.
  createdById   String?    @db.Uuid
  createdByName String?    @db.VarChar(100)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id])
  receivables Receivable[]

  @@unique([tenantId, debtNumber]) // Código sequencial por loja (ADR-026)
  @@index([tenantId, customerId, status]) // Achar a dívida aberta do cliente
  @@index([tenantId, status])
  @@map("debts")
}

/// Recebimento contra uma conta a receber (ADR-019): cada baixa (total ou parcial) da dívida.
/// `paidAt` é o DIA em que o dinheiro entrou — chave do relatório em regime de caixa (o fiado
/// conta como recebido no dia do recebimento, não no dia da venda). Se `method = CASH`, o
/// recebimento gera um `CashMovement SUPPLY` no caixa de hoje (reúso da CX.Movimentacao) —
/// `cashSessionId`/`cashMovementId` guardam esse elo (referências soltas, sem FK).
model ReceivablePayment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid // Denormalizado para isolamento multi-tenant (ADR-003)
  receivableId   String   @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  /// Acréscimo de cartão cobrado NESTE recebimento (ADR-016 × ADR-022, Fatia C.3). Digitado pelo
  /// operador quando recebe por débito/crédito um produto com acréscimo. É receita A MAIS (recupera a
  /// taxa do cartão) — NÃO abate a dívida (o `amount` é que quita); soma no relatório à forma do cartão.
  surcharge      Decimal  @default(0) @db.Decimal(12, 2)
  method         String   @db.VarChar(30) // "CASH", "PIX", "CREDIT_CARD", "DEBIT_CARD"…
  paidAt         DateTime @default(now()) // Dia do recebimento (base do relatório em regime de caixa)
  cashSessionId  String?  @db.Uuid // Caixa que recebeu (quando em dinheiro)
  cashMovementId String?  @db.Uuid // Elo com o Suprimento gerado (quando em dinheiro)
  reference      String?  @db.VarChar(100)
  // Autoria (ADR-010): quem recebeu. Referência solta (sem FK); snapshot do nome.
  receivedById   String?  @db.Uuid
  receivedByName String?  @db.VarChar(100)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([tenantId, paidAt])
  @@index([receivableId])
  @@map("receivable_payments")
}

/// Retirada parcial de um item de pedido (ADR-020): cada evento de saída de mercadoria de um
/// pedido SCHEDULED. Espelha o `ReceivablePayment` do fiado — assim como a dívida é baixada em
/// recebimentos parciais, a mercadoria reservada sai em retiradas parciais. É o LOG auditável do
/// que já foi levado (quanto, quando, por quem); o `OrderItem.deliveredBaseQty` é o cache da soma.
/// Cada retirada dispara a baixa atômica de estoque (ADR-001): `StockMovement EXPENSE` +
/// decremento de `stockQty` + `reservedQty`; `stockMovementId` guarda esse elo (referência solta,
/// sem FK — ≡ `cashMovementId` do fiado).
model OrderItemDelivery {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid // Denormalizado para isolamento multi-tenant (ADR-003)
  orderId         String   @db.Uuid
  orderItemId     String   @db.Uuid
  quantity        Decimal  @db.Decimal(12, 4) // Quantidade em UNIDADE-BASE retirada NESTE evento
  deliveredAt     DateTime @default(now())
  stockMovementId String?  @db.Uuid // Elo com a baixa de estoque gerada (referência solta, sem FK)
  reference       String?  @db.VarChar(100)
  notes           String?  @db.VarChar(300) // Observação da retirada (ex.: "levou no caminhão da obra")
  // Autoria (ADR-010): quem entregou/registrou. Referência solta (sem FK); snapshot do nome.
  deliveredById   String?  @db.Uuid
  deliveredByName String?  @db.VarChar(100)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@index([tenantId, orderItemId])
  @@map("order_item_deliveries")
}

/// Devolução parcial de itens de uma venda (ADR-022, Fatia B). Cabeçalho de UM evento de devolução
/// (N itens): estorna estoque (StockMovement INCOME + stockQty), abate a dívida da venda
/// (`Receivable.returnedAmount`) e, se sobrar valor, o EXCEDENTE vira crédito na loja OU dinheiro no
/// caixa (escolha do operador — `target`). Espelha o `order_item_deliveries` (ADR-020), mas com o
/// acerto de dinheiro. As linhas ficam em `order_return_items`.
model OrderReturn {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid // Denormalizado para RLS (ADR-003)
  orderId          String        @db.Uuid // A venda de origem dos itens devolvidos
  customerId       String?       @db.Uuid // O cliente (quando a venda tinha cliente)
  totalValue       Decimal       @db.Decimal(12, 2) // Valor total devolvido (Σ das linhas)
  abatedAmount     Decimal       @default(0) @db.Decimal(12, 2) // Quanto abateu da dívida da venda
  excessAmount     Decimal       @default(0) @db.Decimal(12, 2) // Excedente (virou crédito ou dinheiro)
  target           ReturnTarget? // Destino do excedente; null quando não houve excedente
  receivableId     String?       @db.Uuid // Dívida abatida (referência solta, quando a venda era a prazo)
  cashMovementId   String?       @db.Uuid // Elo com o RETURN no caixa (quando target = CASH), solta
  customerCreditId String?       @db.Uuid // Elo com a linha de crédito (quando target = STORE_CREDIT), solta
  reason           String        @db.VarChar(500) // Motivo (ADR-004)
  createdAt        DateTime      @default(now())
  // Autoria (ADR-010): quem registrou a devolução. Referência solta; snapshot do nome.
  createdById      String?       @db.Uuid
  createdByName    String?       @db.VarChar(100)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer?         @relation(fields: [customerId], references: [id])
  items    OrderReturnItem[]

  @@index([tenantId, createdAt])
  @@index([orderId])
  @@map("order_returns")
}

/// Uma linha de uma devolução (ADR-022): item devolvido + quanto (em unidade-base) voltou ao
/// estoque + o valor daquele item na devolução.
model OrderReturnItem {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid // Denormalizado para RLS (ADR-003)
  returnId    String  @db.Uuid
  orderItemId String  @db.Uuid
  baseQty     Decimal @db.Decimal(12, 4) // Quantidade em unidade-base devolvida (estorno de estoque)
  value       Decimal @db.Decimal(12, 2) // Valor daquele item na devolução

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderReturn OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@map("order_return_items")
}

/// Livro-razão do CRÉDITO do cliente (ADR-022) — a fonte de verdade auditável do
/// `Customer.creditBalance` (reconciliável por Σ amount). Append-only, análogo ao `StockMovement`
/// (ADR-001): + quando uma devolução vira crédito, − quando o crédito é usado numa venda (Fatia C).
model CustomerCredit {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid // Denormalizado para RLS (ADR-003)
  customerId     String   @db.Uuid
  amount         Decimal  @db.Decimal(12, 2) // ASSINADO: + de devolução, − ao usar numa venda
  origin         String   @db.VarChar(30) // "RETURN" / "SALE_USE" / "MANUAL"
  relatedOrderId String?  @db.Uuid // Venda que gerou/consumiu o crédito (referência solta)
  createdAt      DateTime @default(now())
  // Autoria (ADR-010): quem gerou/consumiu. Referência solta; snapshot do nome.
  createdById    String?  @db.Uuid
  createdByName  String?  @db.VarChar(100)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@index([customerId])
  @@map("customer_credits")
}

/// ORÇAMENTO salvo (ADR-024) — proposta guardada, com código humano `O-000045` (sequencial por loja,
/// mesmo motor do ADR-023). NÃO tem efeito de estoque (proposta, não compromisso): o ADR-001 não é
/// tocado; a baixa real só acontece na venda, se o orçamento for convertido (reusa o PDV/`POST /orders`).
/// Snapshot de apresentação (itens em `QuoteItem`). "Expirado" é derivado de `validUntil` (não é status
/// gravado). Conteúdo editável só em DRAFT; a partir de SENT trava (para mudar, duplica).
model Quote {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @db.Uuid
  quoteNumber      Int // Código sequencial POR LOJA (ADR-024). Exibido como "O-000045".
  customerId       String?     @db.Uuid // Opcional (cliente de balcão sem cadastro)
  // Nome livre de quem é o orçamento (ADR-024, 2.B) — identificação de balcão SEM criar cadastro
  // (a pessoa pode não voltar). Usado quando não há customerId; o cadastro, quando vinculado, manda.
  customerName     String?     @db.VarChar(120)
  status           QuoteStatus @default(DRAFT)
  subtotal         Decimal     @db.Decimal(12, 2)
  discountAmount   Decimal     @default(0) @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  validUntil       DateTime? // Validade ("válido até"); passou a data ⇒ exibido como Expirado
  notes            String?     @db.VarChar(500)
  convertedOrderId String?     @db.Uuid // A venda gerada na conversão (referência com FK SET NULL)
  // Autoria (ADR-010): quem criou. Referência solta; snapshot do nome.
  createdById      String?     @db.Uuid
  createdByName    String?     @db.VarChar(100)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime? // Soft-delete de rascunho criado por engano (ADR-004)

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  convertedOrder Order?      @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)
  items          QuoteItem[]

  @@unique([tenantId, quoteNumber]) // Código sequencial por loja; também indexa a busca por nº
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("quotes")
}

/// Uma linha do orçamento (ADR-024) — snapshot de apresentação. Guarda `saleMode` (BASE/ALT) e
/// `pairGroup` para RECONSTRUIR a linha no PDV ao editar/converter (EF-3/ADR-013, par/ADR-015).
/// `productId` é referência (SET NULL): se o produto for apagado, o snapshot ainda imprime.
model QuoteItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid // Denormalizado para RLS (ADR-003)
  quoteId     String   @db.Uuid
  productId   String?  @db.Uuid
  productName String   @db.VarChar(150) // Snapshot do nome
  unit        UnitType // Snapshot da unidade vendida (base OU embalagem — ADR-013)
  saleMode    String?  @db.VarChar(4) // "BASE" | "ALT" — p/ reconstruir a linha no PDV ao converter
  quantity    Decimal  @db.Decimal(12, 4) // Quantidade na unidade vendida
  unitPrice   Decimal  @db.Decimal(12, 4) // Preço na unidade vendida
  discount    Decimal  @default(0) @db.Decimal(12, 4)
  total       Decimal  @db.Decimal(12, 2)
  pairGroup   Int?     @db.SmallInt // Agrupamento do par (ADR-015)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_items")
}

/// Cesta persistente do PDV (ADR-021): o carrinho-rascunho de um usuário, sincronizado entre
/// dispositivos. **Uma linha por usuário** (PK = `userId`). Os itens ficam como JSONB — um snapshot
/// da UI (par ADR-015, acréscimo ADR-016, unidade fechada ADR-017, `conversionFactor`), não a fonte
/// de verdade: preço/estoque são revalidados no `POST /orders` na hora de vender. RLS isola por
/// USUÁRIO (`auth.uid()`), não só por tenant, pois é dado pessoal (um colega não vê a cesta alheia).
model Cart {
  userId    String   @id @db.Uuid // = users.id; uma cesta por usuário
  tenantId  String   @db.Uuid // Denormalizado para isolamento multi-tenant + RLS
  items     Json     @default("[]") // Snapshot do CartItem[] do cliente (rascunho)
  updatedAt DateTime @updatedAt // Relógio do last-write-wins entre dispositivos

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("carts")
}

/// Movimentação de dinheiro no caixa que NÃO é uma venda: devolução, sangria,
/// suprimento e despesa avulsa. Entra no cálculo do valor esperado do caixa
/// (INCOME soma, EXPENSE subtrai), permitindo lançar a saída de uma devolução
/// no caixa de HOJE sem tocar no caixa original já fechado. `relatedOrderId`
/// referencia a venda de origem (devolução) — referência solta, no estilo de
/// AuditEvent (sem FK), pois a venda pode pertencer a outra sessão.
model CashMovement {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid // Denormalizado para isolamento multi-tenant (ADR-003)
  cashSessionId    String           @db.Uuid
  userId           String           @db.Uuid // Operador que lançou a movimentação
  type             TransactionType // INCOME soma / EXPENSE subtrai do esperado
  kind             CashMovementKind
  amount           Decimal          @db.Decimal(12, 2)
  reason           String?          @db.VarChar(300)
  relatedOrderId   String?          @db.Uuid // Venda de origem (devolução)
  // Campos de sincronização offline
  syncStatus       SyncStatus       @default(SYNCED)
  createdAt        DateTime         @default(now())
  // Autoria (ADR-010): `userId` (solto, sem FK) é o operador; `registeredByName` é o snapshot.
  registeredByName String?          @db.VarChar(100)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, cashSessionId])
  @@map("cash_movements")
}

// =============================================================================
// MÓDULO MATERIAL DE CONSTRUÇÃO — Entrega Pesada
// =============================================================================

/// Entrega de pedido. Ativado pelo módulo "CONSTRUCTION_MATERIALS".
/// Suporta agendamento e controle de frete pesado.
/// ADR-002: status migrado de Int para enum DeliveryStatus
model Delivery {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  orderId       String         @unique @db.Uuid
  customerId    String         @db.Uuid
  scheduledAt   DateTime? // Data/hora agendada para entrega
  deliveredAt   DateTime? // Data/hora efetiva da entrega
  address       String         @db.VarChar(300)
  status        DeliveryStatus @default(PENDING) // ADR-002: enum para type-safety
  driverName    String?        @db.VarChar(100)
  vehiclePlate  String?        @db.VarChar(10)
  totalWeightKg Decimal?       @db.Decimal(10, 3) // Peso total calculado dos itens
  freightCost   Decimal?       @db.Decimal(12, 2)
  notes         String?        @db.VarChar(500)
  // Campos de sincronização offline
  syncStatus    SyncStatus     @default(SYNCED)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, scheduledAt])
  @@map("deliveries")
}

// =============================================================================
// MÓDULO CORE — Estoque
// =============================================================================

/// Movimentação de estoque. Rastreabilidade de entradas e saídas.
model StockMovement {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  productId        String          @db.Uuid
  supplierId       String?         @db.Uuid
  type             TransactionType // INCOME = entrada, EXPENSE = saída
  quantity         Decimal         @db.Decimal(12, 4)
  unitCost         Decimal?        @db.Decimal(12, 4) // Custo unitário na entrada
  reason           String?         @db.VarChar(150) // Ex: "Compra NF 1234", "Ajuste de inventário"
  // Campos de sincronização offline
  syncStatus       SyncStatus      @default(SYNCED)
  createdAt        DateTime        @default(now())
  // Autoria (ADR-010): quem movimentou. Antes NÃO existia — referência solta (sem FK) + snapshot.
  userId           String?         @db.Uuid
  registeredByName String?         @db.VarChar(100)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([tenantId, productId, createdAt])
  @@map("stock_movements")
}

// =============================================================================
// MÓDULO CORE — Auditoria Seletiva
// =============================================================================

/// Auditoria seletiva de eventos críticos (ADR-004)
/// Registra apenas ações sensíveis: cancelamento de venda, alteração de preço,
/// ajuste manual de estoque, fechamento de caixa com divergência, mudança de papel
model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String?  @db.Uuid // Usuário que executou a ação (null para ações do sistema)
  entity    String   @db.VarChar(60) // Ex: "Order", "Product", "CashSession", "User"
  entityId  String   @db.Uuid // ID da entidade afetada
  action    String   @db.VarChar(60) // Ex: "CANCEL_ORDER", "CHANGE_PRICE", "ADJUST_STOCK", "CLOSE_CASH_WITH_DIVERGENCE"
  meta      Json? // Metadados compactos da ação (valores antes/depois, motivo, etc.)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_events")
}

/// Idempotência FORTE da importação de NF-e (ADR-025 §5.B, Fatia 2.B). Uma linha por item de nota
/// efetivamente lançado no estoque. O índice único (tenantId, accessKey, nItem) é a garantia DURA:
/// tentar lançar o MESMO item duas vezes gera P2002 → rollback da transação da entrada → nunca dobra
/// estoque (a 2.A só tinha um AuditEvent, sem constraint). Gravado na MESMA transação do StockMovement;
/// guarda o `movementId` para rastreio/estorno. Notas SEM chave de acesso (44 díg.) não entram aqui —
/// não há como deduplicá-las —, e a entrada segue como na 2.A. O GET /imported lê esta tabela em UNIÃO
/// com o AuditEvent legado (notas da 2.A seguem pré-marcadas, sem backfill).
model NfeImportItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  accessKey   String   @db.VarChar(44)
  nItem       Int
  productId   String?  @db.Uuid
  movementId  String?  @db.Uuid // StockMovement gerado — referência solta (sem FK), como a autoria
  quantity    Decimal  @db.Decimal(12, 4)
  notaNumber  String?  @db.VarChar(20)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([tenantId, accessKey, nItem])
  @@index([tenantId, accessKey])
  @@map("nfe_import_items")
}
