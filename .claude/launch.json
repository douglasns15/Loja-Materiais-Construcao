{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@nexoloja/web"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/api/scripts/dev-local.mjs"
      ],
      "port": 8787,
      "url": "http://localhost:8787"
    },
    {
      "name": "web-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--config",
        "apps/web/wrangler.jsonc",
        "--port",
        "8788"
      ],
      "port": 8788
    }
  ]
}
